{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/conteudo.json",
      "destination": "https://wdutzqbycpej0fn6.public.blob.vercel-storage.com/site/content.json"
    }
  ],
  "functions": {
    "api/content.js": {
      "includeFiles": "src/content.json",
      "maxDuration": 15
    },
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/upload.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
