# Variáveis de ambiente do site (configure na Vercel: Project → Settings → Environment Variables).
# Pegue os valores no Supabase: Project Settings → API (ou "API Keys").
# NUNCA coloque aqui a service_role / secret key — o site não precisa dela.

# URL do projeto Supabase (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública do Supabase: "anon" (legada) ou "publishable" (sb_publishable_...)
SUPABASE_ANON_KEY=
